# ─────────────────────────────────────────────
# REQUIRED — the server will exit on startup if
# any of these are missing or empty in production.
# ─────────────────────────────────────────────

# See docs/SECURE_CONFIGURATION.md for the safe production default, the
# local-development override, and the risk of weakening each setting.

# Soroban contract ID for Freighter pledge signing (deploy with `npm run deploy:contract`)
CONTRACT_ID=

# ─────────────────────────────────────────────
# OPTIONAL — sensible defaults are shown below.
# ─────────────────────────────────────────────

# HTTP port the Express server listens on (default: 3001)
PORT=3001

# Logging verbosity: debug | info | warn | error | silent (default: info)
# SECURITY: debug is rejected when NODE_ENV=production (enforced at startup).
LOG_LEVEL=info

# SQLite database file path (default: backend/data/campaigns.db)
# DB_PATH=backend/data/campaigns.db

# Comma-separated asset codes accepted by the API (default: USDC,XLM)
ALLOWED_ASSETS="USDC,XLM,ARS"

# Comma-separated origins allowed by CORS
# See docs/SECURE_CONFIGURATION.md for production configuration examples and security risks
#
# SAFE PRODUCTION DEFAULT: Explicit HTTPS origins, comma-separated
# Examples:
#   Single app: ALLOWED_ORIGINS=https://myapp.example.com
#   Multiple apps: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
#   Subdomains: ALLOWED_ORIGINS=https://*.example.com
#   Platform: ALLOWED_ORIGINS=https://stellar-goal-vault.vercel.app
#
# LOCAL DEVELOPMENT: Use wildcard or leave empty
#   ALLOWED_ORIGINS="*"  # Recommended for local development
#   ALLOWED_ORIGINS=""   # Also works in development mode
#
# SECURITY RISKS (rejected in production):
#   - Wildcard (*) allows any website to call the API from a browser
#   - HTTP origins are rejected (must use HTTPS)
#   - Localhost (localhost, 127.0.0.1) is rejected in production
#   - Raw IP addresses are rejected in production
#   - Invalid URL formats are rejected
#
# BACKWARDS COMPATIBILITY: CORS_ALLOWED_ORIGINS is accepted as an alias
# New deployments should use ALLOWED_ORIGINS
#
# STARTUP VALIDATION: Server will not start if production config is invalid
ALLOWED_ORIGINS="*"

# Soroban RPC endpoint (default: Stellar testnet)
# SECURITY: must use HTTPS when NODE_ENV=production (enforced at startup).
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443

# Stellar network passphrase (default: testnet)
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Decimal scaling between display amounts and on-chain units (default: 2)
CONTRACT_AMOUNT_DECIMALS=2

# Maximum pledge per contributor across a single campaign, 0 = no limit (default: 0)
DEFAULT_MAX_PER_CONTRIBUTOR=0

# Comma-separated ASSET_CODE:CONTRACT_ADDRESS pairs for on-chain asset lookup
# ASSET_ADDRESSES=XLM:CDLZFC3SYJYDZT7K3SSTH3YCUY6AFMCO3Y6S3G7FEYZNVNREK7Y6CYN5,USDC:CA6WSTPZ7RRCUC6H37CQFODG763XG2HXP2G6F367VCOGGVDP32P7665E

# ─────────────────────────────────────────────
# PRODUCTION FEATURES (optional)
# ─────────────────────────────────────────────

# Node environment: development | test | production (default: development)
# SECURITY: values outside this list (e.g. prod) fail startup (enforced at startup).
# NODE_ENV=production

# API key authentication (comma-separated list of valid API keys)
# Only enforced when NODE_ENV=production
# SECURITY: if this is empty in production, write endpoints are UNAUTHENTICATED.
# Always set API_KEYS in production. See docs/SECURE_CONFIGURATION.md.
# ABUSE CONTROLS: Failed auth attempts are rate limited (10 per minute per IP).
# Per-API-key usage is tracked (1000 requests per minute) to prevent key abuse.
# API_KEYS=key1,key2,key3

# Webhook signing secret (HMAC-SHA256, sent as X-GoalVault-Signature).
# SECURITY: REQUIRED in production when WEBHOOK_URL is set (enforced at startup).
# WEBHOOK_SECRET=

# Redis cache URL for production deployments
# Format: redis://[:password@]host[:port][/db]
# Only used when NODE_ENV=production
# REDIS_URL=redis://localhost:6379

# Cache TTL in seconds (default: 300)
# CACHE_TTL=300
