# Stellar Goal Vault Environment Variables Example
# Copy this file to .env and fill in the actual values

# Server Configuration
PORT=3000
NODE_ENV=development

# Stellar Network Configuration
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443

# Contract IDs (automatically updated by CI/CD)
TESTNET_CONTRACT_ID=
STAGING_CONTRACT_ID=
MAINNET_CONTRACT_ID=

# Stellar Account Configuration
# The secret key for the server account used for contract operations
SERVER_PRIVATE_KEY=

# Wallet Integration
WALLET_INTEGRATION_READY=true
CONTRACT_AMOUNT_DECIMALS=7

# Asset Addresses (Soroban contract addresses for supported assets)
# Format: ASSET_CODE=contract_address
XLM=
USDC=
EURC=

# Allowed Assets for Campaigns
ALLOWED_ASSETS=XLM,USDC,EURC

# Database Configuration (if using a database)
# DATABASE_URL=

# CORS Configuration
# CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Background Job Health (see docs/JOB_HEALTH.md)
# Seconds without a successful indexer poll before GET /api/health reports it "stale".
# Leave unset to use max(120, 4 x SOROBAN_POLL_INTERVAL_MS).
# INDEXER_STALE_AFTER_SECONDS=120
# Consecutive failed runs before a job is reported "failing".
# JOB_FAILING_AFTER_FAILURES=3
# Upper bound (seconds) for reported freshness_lag_seconds.
# JOB_MAX_REPORTED_LAG_SECONDS=86400
