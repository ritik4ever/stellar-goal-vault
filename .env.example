# Stellar Goal Vault Environment Variables Example
# Copy this file to .env and fill in the actual values
# See docs/SECURE_CONFIGURATION.md for the safe production default, the
# local-development override, and the risk of weakening each setting.
# Never commit a real .env file or secret.

# Server Configuration
PORT=3000
NODE_ENV=development

# Stellar Network Configuration
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443

# Contract IDs (automatically updated by CI/CD)
TESTNET_CONTRACT_ID=
STAGING_CONTRACT_ID=
MAINNET_CONTRACT_ID=

# Stellar Account Configuration
# The secret key for the server account used for contract operations
# SECURITY: never commit this value; inject it from a secret manager in production.
SERVER_PRIVATE_KEY=

# Wallet Integration
WALLET_INTEGRATION_READY=true
CONTRACT_AMOUNT_DECIMALS=7

# Asset Addresses (Soroban contract addresses for supported assets)
# Format: ASSET_CODE=contract_address
XLM=
USDC=
EURC=

# Allowed Assets for Campaigns
ALLOWED_ASSETS=XLM,USDC,EURC

# Database Configuration (if using a database)
# DATABASE_URL=

# CORS Configuration
# CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
